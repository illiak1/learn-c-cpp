@expect

--- Q6: Right-Angled Triangle ---
A
AA
AAA
AAAA
@checklist
- Uses exactly two nested for loops.
- Prints a newline after each row.

@task c-isosceles-triangle
@title drawIsocelesTriangle
@points 10
@lesson 01_intro
@statement
Q7: Output an isosceles (diamond-like) triangle of 'A's using 2 for loops
and at most 1 if/else:
A
AA
AAA
AAAA
AAA
AA
A
@includes
#include <stdio.h>
@stub
void drawIsocelesTriangle() {
    // your code here
}
@solution
void drawIsocelesTriangle() {
    int count;
    for (int row = 1; row <= 7; row++) {
        if (row <= 4) {
            count = row;        // going up: 1,2,3,4
        } else {
            count = 8 - row;    // going down: 3,2,1
        }
        for (int col = 1; col <= count; col++) {
            printf("A");
        }
        printf("\n");
    }
}
@tests
printf("\n--- Q7: Isosceles Triangle ---\n");
drawIsocelesTriangle();
@expect

--- Q7: Isosceles Triangle ---
A
AA
AAA
AAAA
AAA
AA
A
@checklist
- Uses two for loops and at most one if/else.
- The row length grows to 4 and then shrinks again.

@task c-isosceles-triangle-2
@title drawIsocelesTriangle2 (extra)
@points 10
@lesson 01_intro
@statement
Q19 (EXTRA): Output the same diamond pattern as Q7 using only 2 for loops
and no conditional statements.
@includes
#include <stdio.h>
#include <stdlib.h>
@stub
void drawIsocelesTriangle2() {
    // your code here
}
@solution
void drawIsocelesTriangle2() {
    for (int row = 0; row < 7; row++) {
        // abs(row - 3) is 3,2,1,0,1,2,3 so count is 1,2,3,4,3,2,1
        int count = 4 - abs(row - 3);
        for (int col = 0; col < count; col++) {
            printf("A");
        }
        printf("\n");
    }
}
@tests
printf("\n--- Q19 (EXTRA): Isosceles Triangle 2 ---\n");
drawIsocelesTriangle2();
@expect

--- Q19 (EXTRA): Isosceles Triangle 2 ---
A
AA
AAA
AAAA
AAA
AA
A
@checklist
- Uses only two for loops and no conditional statements.
- The row length can be computed with abs().

@task c-find
@title find
@points 10
@lesson 01_intro
@statement
Q8: Find an element in an array and print the index where it was found,
or -1 if not found.
@includes
#include <stdio.h>
@stub
int find(int size, int arr[], int toFind) {
    // your code here
    return 0;
}
@solution
int find(int size, int arr[], int toFind) {
    for (int i = 0; i < size; i++) {
        if (arr[i] == toFind) {
            return i;
        }
    }
    return -1;
}
@tests
printf("\n--- Q8: Find Element Index Test ---\n");
int testFindArr[] = {10, 20, 30};
if (find(3, testFindArr, 20) == 1) printf("yes\n"); else printf("no\n");
@expect

--- Q8: Find Element Index Test ---
yes
@checklist
- Returns the index of the first match.
- Returns -1 when the value is not in the array.

@task c-second-largest
@title find2ndLargest
@points 10
@lesson 01_intro
@statement
Q9: Find and return the second largest element in an array of positive
integers; returns -1 if it can't find one.
@includes
#include <stdio.h>
@stub
int find2ndLargest(int size, int arr[]) {
    // your code here
    return 0;
}
@solution
int find2ndLargest(int size, int arr[]) {
    int largest = -1;
    int second = -1;
    for (int i = 0; i < size; i++) {
        if (arr[i] > largest) {
            second = largest;       // old largest becomes second
            largest = arr[i];
        } else if (arr[i] < largest && arr[i] > second) {
            second = arr[i];
        }
    }
    return second;
}
@tests
// Array setup (as in the original paper)
int myArr[10] = {1, 4, 3, 4, 2}; 
int currentCount = 5;
printf("\n--- Q9: Second Largest Test ---\n");
if (find2ndLargest(currentCount, myArr) == 3) printf("yes\n"); else printf("no\n");
@expect

--- Q9: Second Largest Test ---
yes
@checklist
- Tracks the largest and second largest in one pass.
- Ignores duplicates of the largest value.
- Returns -1 when there is no second largest.

