    	currentCount++;
    	if (myArr[2] == 99) printf("yes\n"); else printf("no\n");
    } else {
    	printf("no\n");
    }

    printf("\n--- Q12: Delete Element Test ---\n");
    if (deleteElement(10, currentCount, myArr, 2)) {
        currentCount--; 
        if (myArr[2] == 3) printf("yes\n"); else printf("no\n");
    }

    printf("\n--- Q15: Reverse Array Test ---\n");
    reverse(currentCount, myArr);
    if (myArr[0] == 2 && myArr[4] == 1) printf("yes\n"); else printf("no\n");

    printf("\n--- Q16: Rotate Left Test ---\n");
    rotateLeft(currentCount, myArr);
    if (myArr[0] == 4 && myArr[4] == 2) printf("yes\n"); else printf("no\n");

    printf("\n--- Q17: Two Movies Test ---\n");
    if (twoMovies(5, myArr, currentCount)) printf("yes\n"); else printf("no\n");

    printf("\n--- Q19: Print 2D Array ---\n");
    int array[4][6] = { {0,0,3,1,3,4},
                        {0,0,2,3,4,3},
                        {0,0,1,3,3,2},
                        {0,0,1,1,1,1} };
    PrintArray(array);

    return 0;
}
