    printf("\n--- Q8: Find Element Index Test ---\n");
    int testFindArr[] = {10, 20, 30};
    if (find(3, testFindArr, 20) == 1) printf("yes\n"); else printf("no\n");


    // Array setup for Q9 to Q17 tests
    int myArr[10] = {1, 4, 3, 4, 2}; 
    int currentCount = 5;

    printf("\n--- Q9: Second Largest Test ---\n");
    if (find2ndLargest(currentCount, myArr) == 3) printf("yes\n"); else printf("no\n");

