@task c-insert-element
@title insertElement
@points 10
@lesson 01_intro
@statement
Q11: Insert an element at a specified index in the array, shifting elements
to the right. 'count' tracks the number of elements and cannot exceed 'size'.
Returns true if an element was inserted, otherwise false.
@includes
#include <stdio.h>
#include <stdbool.h>
@stub
bool insertElement(int size, int count, int arr[], int elementToInsert, int insertIndex) {
    // your code here
    return false;
}
@solution
bool insertElement(int size, int count, int arr[], int elementToInsert, int insertIndex) {
    if (count >= size) {                        // array is full
        return false;
    }
    if (insertIndex < 0 || insertIndex > count) {   // bad index
        return false;
    }
    // shift elements right, starting from the end
    for (int i = count; i > insertIndex; i--) {
        arr[i] = arr[i - 1];
    }
    arr[insertIndex] = elementToInsert;
    return true;
}
@tests
int myArr[10] = {1, 4, 3, 4, 2};
int currentCount = 5;

printf("\n--- Q11: Insert Element Test ---\n");
if (insertElement(10, currentCount, myArr, 99, 2)) {
	currentCount++;
	if (myArr[2] == 99) printf("yes\n"); else printf("no\n");
} else {
	printf("no\n");
}
@expect

--- Q11: Insert Element Test ---
yes
@checklist
- Returns false when the array is full or the index is invalid.
- Shifts elements to the right starting from the end.

@task c-delete-element
@title deleteElement
@points 10
@lesson 01_intro
@statement
Q12: Delete an element at a specified position, shifting higher elements
to the left by one. 'count' tracks the number of elements and cannot exceed
'size'. Returns true if an element was deleted, otherwise false.
@includes
#include <stdio.h>
#include <stdbool.h>
@stub
bool deleteElement(int size, int count, int arr[], int deleteIndex) {
    // your code here
    return false;
}
@solution
bool deleteElement(int size, int count, int arr[], int deleteIndex) {
    if (deleteIndex < 0 || deleteIndex >= count) {  // bad index
        return false;
    }
    // shift elements left, starting from the deleted position
    for (int i = deleteIndex; i < count - 1; i++) {
        arr[i] = arr[i + 1];
    }
    return true;
}
@tests
// state of the array after Q11 in the original paper
int myArr[10] = {1, 4, 99, 3, 4, 2};
int currentCount = 6;

printf("\n--- Q12: Delete Element Test ---\n");
if (deleteElement(10, currentCount, myArr, 2)) {
    currentCount--; 
    if (myArr[2] == 3) printf("yes\n"); else printf("no\n");
}
@expect

--- Q12: Delete Element Test ---
yes
@checklist
- Returns false for an invalid index.
- Shifts the higher elements one place to the left.

@task c-frequency-count
@title frequencyCount
@points 10
@lesson 01_intro
@statement
Q13: Count the frequency of a given element in an array.
@includes
#include <stdio.h>
@stub
int frequencyCount(int size, int arr[], int value) {
    // your code here
    return 0;
}
@solution
int frequencyCount(int size, int arr[], int value) {
    int count = 0;
    for (int i = 0; i < size; i++) {
        if (arr[i] == value) {
            count++;
        }
    }
    return count;
}
@tests
int myArr[10] = {1, 4, 3, 4, 2};
int currentCount = 5;

printf("\n--- Q13: Frequency Count Test ---\n");
if (frequencyCount(currentCount, myArr, 4) == 2) printf("yes\n"); else printf("no\n");
@expect

--- Q13: Frequency Count Test ---
yes
@checklist
- Counts how many elements equal the value.

@task c-count-duplicates
@title countDuplicates
@points 10
@lesson 01_intro
@statement
Q14: Count the total number of duplicate elements in an array.
(An element is a duplicate if the same value appears earlier in the array.)
@includes
#include <stdio.h>
@stub
int countDuplicates(int size, int arr[]) {
    // your code here
    return 0;
}
@solution
int countDuplicates(int size, int arr[]) {
    int duplicates = 0;
    for (int i = 1; i < size; i++) {
        for (int j = 0; j < i; j++) {
            if (arr[i] == arr[j]) {
                duplicates++;
                break;      // count each element only once
            }
        }
    }
    return duplicates;
}
@tests
int myArr[10] = {1, 4, 3, 4, 2};
int currentCount = 5;

printf("\n--- Q14: Count Duplicates Test ---\n");
if (countDuplicates(currentCount, myArr) == 1) printf("yes\n"); else printf("no\n");
@expect

--- Q14: Count Duplicates Test ---
yes
@checklist
- An element counts as a duplicate when the same value appears earlier.
- Each duplicate element is counted only once.

@task c-reverse-array
@title reverse
@points 10
@lesson 01_intro
@statement
Q15: Reverse an array in place using only 1 array.
@includes
#include <stdio.h>
@stub
void reverse(int size, int arr[]) {
    // your code here
}
@solution
void reverse(int size, int arr[]) {
    int left = 0;
    int right = size - 1;
    while (left < right) {
        int temp = arr[left];
        arr[left] = arr[right];
        arr[right] = temp;
        left++;
        right--;
    }
}
@tests
int myArr[10] = {1, 4, 3, 4, 2};
int currentCount = 5;

printf("\n--- Q15: Reverse Array Test ---\n");
reverse(currentCount, myArr);
if (myArr[0] == 2 && myArr[4] == 1) printf("yes\n"); else printf("no\n");
@expect

--- Q15: Reverse Array Test ---
yes
@checklist
- Works in place with a single array (swap from both ends).

@task c-rotate-left
@title rotateLeft
@points 10
@lesson 01_intro
@statement
Q16: Left rotate an array by one position, moving the first element to the end.
Returns 0 on success, -1 if the array is empty.
@includes
#include <stdio.h>
@stub
int rotateLeft(int size, int arr[]) {
    // your code here
    return 0;
}
@solution
int rotateLeft(int size, int arr[]) {
    if (size <= 0) {
        return -1;
    }
    int first = arr[0];                 // save the first element
    for (int i = 0; i < size - 1; i++) {
        arr[i] = arr[i + 1];            // shift everything left
    }
    arr[size - 1] = first;              // put the first element at the end
    return 0;
}
@tests
// state of the array after Q15 in the original paper
int myArr[10] = {2, 4, 3, 4, 1};
int currentCount = 5;

printf("\n--- Q16: Rotate Left Test ---\n");
rotateLeft(currentCount, myArr);
if (myArr[0] == 4 && myArr[4] == 2) printf("yes\n"); else printf("no\n");
@expect

--- Q16: Rotate Left Test ---
yes
@checklist
- Returns -1 for an empty array, 0 otherwise.
- Saves the first element before shifting everything left.

@task c-two-movies
@title twoMovies
@points 10
@lesson 01_intro
@statement
Q17: Given a flight length and an array of movie lengths, return true if
there are exactly two movies whose runtimes sum to the flight length.
Users watch exactly two movies and cannot watch the same movie twice.
@includes
#include <stdio.h>
#include <stdbool.h>
@stub
bool twoMovies(int flightLength, int movieLengths[], int size) {
    // your code here
    return false;
}
@solution
bool twoMovies(int flightLength, int movieLengths[], int size) {
    for (int i = 0; i < size; i++) {
        for (int j = i + 1; j < size; j++) {    // j starts after i: never the same movie
            if (movieLengths[i] + movieLengths[j] == flightLength) {
                return true;
            }
        }
    }
    return false;
}
@tests
// state of the array after Q16 in the original paper
int myArr[10] = {4, 3, 4, 1, 2};
int currentCount = 5;

printf("\n--- Q17: Two Movies Test ---\n");
if (twoMovies(5, myArr, currentCount)) printf("yes\n"); else printf("no\n");
@expect

--- Q17: Two Movies Test ---
yes
@checklist
- Tries every pair of different movies.
- Never uses the same movie twice (j starts after i).

